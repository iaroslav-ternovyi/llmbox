[Unit]
Description=llmbox intake: takes submitted measurements, rebuilds and publishes the site
After=network-online.target
Wants=network-online.target

[Service]
User=llmbox
WorkingDirectory=/home/llmbox/llmbox
EnvironmentFile=/etc/llmbox.env
Environment=PATH=/home/llmbox/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=LLMBOX_SANDBOX=/home/llmbox/llmbox/deploy/sandbox.sh
# LLMBOX_STATS=https://stats.<host> in /etc/llmbox.env turns the site's visit counter on
ExecStart=/home/llmbox/venv/bin/llmbox serve --bind 127.0.0.1 --port 8767 --rebuild /home/llmbox/site --deploy "cd /home/llmbox/llmbox/deploy/pages && npx --yes wrangler pages deploy {site} --project-name llmbox --branch main --commit-dirty=true"
Restart=always
RestartSec=5
MemoryMax=3G
TasksMax=1024
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/llmbox
PrivateTmp=true

[Install]
WantedBy=multi-user.target
